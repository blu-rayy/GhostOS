{
  "name": "ghostos-frontend",
  "productName": "GhostOS",
  "private": true,
  "version": "0.1.0",
  "description": "GhostOS desktop UI (React + Vite, runs in the browser and in Electron).",
  "author": "GhostOS team (AppBuildersPH Hackathon 2026)",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:browser": "vite --host 127.0.0.1 --strictPort",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "dev": "concurrently -k -n vite,electron -c magenta,cyan \"npm:dev:browser\" \"npm:dev:electron\"",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "electron:preview": "npm run build && electron .",
    "package:win": "cross-env VITE_USE_FIXTURES=false npm run build && electron-builder --win",
    "package:win:demo": "cross-env VITE_USE_FIXTURES=true npm run build && electron-builder --win -c.directories.output=release/demo",
    "package:dir": "cross-env VITE_USE_FIXTURES=false npm run build && electron-builder --win --dir",
    "package:win:signed": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-signed.ps1",
    "pip-lab": "vite --host 127.0.0.1 --open /pip-lab.html"
  },
  "dependencies": {
    "@fontsource/gochi-hand": "5.3.0",
    "@fontsource/patrick-hand": "5.3.0",
    "@fontsource/space-mono": "5.3.0",
    "lucide-react": "^1.54.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "com.ghostos.app",
    "productName": "GhostOS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "asarUnpack": [
      "electron/*.ps1"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "electron/icon.png",
      "signtoolOptions": {
        "publisherName": [
          "GhostOS team"
        ],
        "signingHashAlgorithms": [
          "sha256"
        ]
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "GhostOS-Setup-${version}.${ext}"
    }
  }
}
